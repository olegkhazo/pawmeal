# Copy this file to .env and fill in real values. Never commit .env.
# See README.md for what each variable does and docs/progress.md for what is
# still a placeholder before a real production launch.

# PostgreSQL connection string. Local dev matches docker-compose.yml.
DATABASE_URL="postgresql://pawmeal:pawmeal@localhost:5432/pawmeal?schema=public"

# Public base URL of the deployed site (used for canonical/hreflang/sitemap).
PUBLIC_SITE_URL="http://localhost:3000"

# Temporary, fully-configurable brand name shown on the site.
BRAND_NAME="PawMeal Georgia"

# Operator-facing contact points. Placeholders only — production is not
# considered launch-ready until these are real, monitored destinations.
BUSINESS_WHATSAPP_NUMBER=""
BUSINESS_TELEGRAM_USERNAME=""
OPERATOR_CONTACT_EMAIL=""

# How many days a lead's personal data is retained before scripts/purge-expired-leads
# deletes it. Owner-configured; no default is assumed to be legally sufficient.
DATA_RETENTION_DAYS="90"

# Price experiment is off by default — no price is shown to visitors until the
# owner explicitly configures and approves segment prices server-side.
PRICE_TEST_ENABLED="false"

# Which analytics adapter to load, if any. Empty/"none" keeps analytics fully
# disabled. Analytics must stay off until consent handling is wired up.
ANALYTICS_PROVIDER="none"
